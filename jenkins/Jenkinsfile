
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        AWS_REGION = 'ap-south-1'
        ECR_REGISTRY = '742986823560.dkr.ecr.ap-south-1.amazonaws.com'

        BACKEND_ECR_REPOSITORY = 'enterprise-backend'
        FRONTEND_ECR_REPOSITORY = 'enterprise-frontend'
    }

    stages {

        // ==========================================
        // 1. CHECKOUT SOURCE CODE
        // ==========================================

        stage('Checkout Source Code') {
            steps {
                checkout scm
            }
        }

        // ==========================================
        // 2. DISPLAY GIT INFORMATION
        // ==========================================

        stage('Display Git Information') {
            steps {
                sh '''
                    echo "===== GIT INFORMATION ====="
                    git log -1 --oneline
                    git rev-parse HEAD
                '''

                echo "Previous successful commit: ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: 'NOT AVAILABLE'}"

                script {
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()
                }
            }
        }

        // ==========================================
        // 3. DETECT CHANGED APPLICATIONS
        // ==========================================

        stage('Detect Changed Applications') {
            steps {
                script {
                    def previousCommit =
                        env.GIT_PREVIOUS_SUCCESSFUL_COMMIT?.trim()

                    def currentCommit = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    def buildBackend = false
                    def buildFrontend = false

                    echo "Current commit: ${currentCommit}"
                    echo "Previous successful commit: ${previousCommit ?: 'NOT AVAILABLE'}"

                    // Safe fallback: build both if no valid baseline exists.

                    def validBaseline = previousCommit &&
                        sh(
                            script: "git cat-file -e '${previousCommit}^{commit}'",
                            returnStatus: true
                        ) == 0

                    if (!validBaseline) {
                        echo 'No valid previous successful commit found.'
                        echo 'Safely building both applications.'

                        buildBackend = true
                        buildFrontend = true

                    } else {

                        def changedOutput = sh(
                            script: "git diff --name-only '${previousCommit}' '${currentCommit}'",
                            returnStdout: true
                        ).trim()

                        def changedFiles = changedOutput ?
                            changedOutput.readLines() : []

                        echo '===== CHANGED FILES ====='

                        changedFiles.each { file ->
                            echo file
                        }

                        if (changedFiles.isEmpty()) {
                            echo 'No changed files detected. Safe fallback: build both.'

                            buildBackend = true
                            buildFrontend = true

                        } else {

                            changedFiles.each { file ->

                                if (file.startsWith('app/server/')) {
                                    buildBackend = true
                                    echo "Backend change detected: ${file}"

                                } else if (file.startsWith('app/client/')) {
                                    buildFrontend = true
                                    echo "Frontend change detected: ${file}"

                                } else if (
                                    file.startsWith('jenkins/') ||
                                    file == 'Jenkinsfile' ||
                                    file == 'package.json' ||
                                    file == 'package-lock.json' ||
                                    file == '.gitignore' ||
                                    file.startsWith('app/')
                                ) {
                                    // Shared or CI changes affect both.

                                    buildBackend = true
                                    buildFrontend = true

                                    echo "Shared configuration change detected: ${file}"

                                } else if (
                                    file.startsWith('docs/') ||
                                    file.toLowerCase().endsWith('.md') ||
                                    file == 'LICENSE'
                                ) {
                                    echo "Documentation-only change: ${file}"

                                } else {
                                    // Unknown changes use a safe default.

                                    buildBackend = true
                                    buildFrontend = true

                                    echo "Unclassified change; building both: ${file}"
                                }
                            }
                        }
                    }

                    env.BUILD_BACKEND = buildBackend.toString()
                    env.BUILD_FRONTEND = buildFrontend.toString()

                    echo '===== BUILD DECISION ====='
                    echo "Build Backend: ${env.BUILD_BACKEND}"
                    echo "Build Frontend: ${env.BUILD_FRONTEND}"
                    echo "Image Tag: ${env.IMAGE_TAG}"
                }
            }
        }

        // ==========================================
        // 4. VERIFY PROJECT STRUCTURE
        // ==========================================

        stage('Verify Project Structure') {
            when {
                expression {
                    env.BUILD_BACKEND == 'true' ||
                    env.BUILD_FRONTEND == 'true'
                }
            }

            steps {
                sh '''
                    set -eu

                    echo "===== VERIFYING PROJECT FILES ====="

                    if [ "$BUILD_BACKEND" = "true" ]; then
                        test -f app/server/package.json
                        test -f app/server/package-lock.json
                        test -f app/server/config/init.sql
                        test -f app/server/Dockerfile.prod
                    fi

                    if [ "$BUILD_FRONTEND" = "true" ]; then
                        test -f app/client/package.json
                        test -f app/client/package-lock.json
                        test -f app/client/Dockerfile.prod
                        test -f app/client/nginx.conf
                    fi

                    echo "Project structure verified!"
                '''
            }
        }

        // ==========================================
        // BACKEND CI
        // ==========================================

        stage('Backend Dependency Installation') {
            when {
                expression { env.BUILD_BACKEND == 'true' }
            }

            steps {
                dir('app/server') {
                    sh 'npm ci'
                }
            }
        }

        stage('Backend Lint') {
            when {
                expression { env.BUILD_BACKEND == 'true' }
            }

            steps {
                dir('app/server') {
                    sh 'npm run lint'
                }
            }
        }

        stage('Backend Tests') {
            when {
                expression { env.BUILD_BACKEND == 'true' }
            }

            steps {
                dir('app/server') {
                    withEnv([
                        "TEST_DB_CONTAINER=jenkins-test-db-${env.BUILD_NUMBER}",
                        "POSTGRES_USER=ci_user",
                        "POSTGRES_PASSWORD=ci-only-temporary-password",
                        "POSTGRES_DB_TEST=enterprise_test",
                        "SECRET=ci-only-test-access-secret",
                        "REFRESH_SECRET=ci-only-test-refresh-secret"
                    ]) {
                        sh '''
                            set +x
                            set -eu

                            cleanup() {
                                echo "===== CLEANING TEST DATABASE ====="
                                docker rm -f "$TEST_DB_CONTAINER" \
                                    >/dev/null 2>&1 || true
                            }

                            trap cleanup EXIT

                            echo "===== STARTING TEST POSTGRESQL ====="

                            docker run -d \
                                --name "$TEST_DB_CONTAINER" \
                                --restart=no \
                                --memory=512m \
                                -e POSTGRES_USER="$POSTGRES_USER" \
                                -e POSTGRES_PASSWORD="$POSTGRES_PASSWORD" \
                                -e POSTGRES_DB="$POSTGRES_DB_TEST" \
                                -p 127.0.0.1::5432 \
                                --health-cmd="pg_isready -U $POSTGRES_USER -d $POSTGRES_DB_TEST" \
                                --health-interval=5s \
                                --health-timeout=3s \
                                --health-retries=20 \
                                postgres:18 >/dev/null

                            echo "===== WAITING FOR POSTGRESQL ====="

                            status=starting

                            for attempt in $(seq 1 30); do
                                status=$(docker inspect \
                                    --format='{{.State.Health.Status}}' \
                                    "$TEST_DB_CONTAINER")

                                if [ "$status" = "healthy" ]; then
                                    break
                                fi

                                container_state=$(docker inspect \
                                    --format='{{.State.Status}}' \
                                    "$TEST_DB_CONTAINER")

                                if [ "$container_state" = "exited" ] || \
                                   [ "$container_state" = "dead" ]; then
                                    docker logs "$TEST_DB_CONTAINER"
                                    exit 1
                                fi

                                sleep 2
                            done

                            if [ "$status" != "healthy" ]; then
                                echo "PostgreSQL failed to become healthy"
                                docker logs "$TEST_DB_CONTAINER"
                                exit 1
                            fi

                            echo "PostgreSQL is healthy!"

                            POSTGRES_PORT=$(docker port \
                                "$TEST_DB_CONTAINER" 5432/tcp \
                                | awk -F: 'NR == 1 {print $NF}')

                            if [ -z "$POSTGRES_PORT" ]; then
                                echo "Could not determine PostgreSQL port"
                                exit 1
                            fi

                            export POSTGRES_HOST=127.0.0.1
                            export POSTGRES_PORT
                            export NODE_ENV=test

                            echo "===== INITIALIZING DATABASE SCHEMA ====="

                            docker exec -i "$TEST_DB_CONTAINER" \
                                psql -v ON_ERROR_STOP=1 \
                                -U "$POSTGRES_USER" \
                                -d "$POSTGRES_DB_TEST" \
                                < config/init.sql

                            echo "===== RUNNING BACKEND TESTS ====="

                            npm test

                            echo "Backend tests completed!"
                        '''
                    }
                }
            }
        }

        // ==========================================
        // FRONTEND CI
        // ==========================================

        stage('Frontend Dependency Installation') {
            when {
                expression { env.BUILD_FRONTEND == 'true' }
            }

            steps {
                dir('app/client') {
                    sh 'npm ci --legacy-peer-deps'
                }
            }
        }

        stage('Frontend Lint and Tests') {
            when {
                expression { env.BUILD_FRONTEND == 'true' }
            }

            steps {
                dir('app/client') {
                    sh '''
                        set -eu

                        echo "===== CHECKING FRONTEND SCRIPTS ====="

                        node -e "
                            const p = require('./package.json');
                            console.log(JSON.stringify(p.scripts || {}, null, 2));
                        "

                        if node -e "process.exit(require('./package.json').scripts?.lint ? 0 : 1)"; then
                            echo "===== RUNNING FRONTEND LINT ====="
                            npm run lint
                        else
                            echo "No frontend lint script configured; skipping."
                        fi

                        if node -e "process.exit(require('./package.json').scripts?.test ? 0 : 1)"; then
                            echo "===== RUNNING FRONTEND TESTS ====="
                            npm test -- --run
                        else
                            echo "No frontend test script configured; skipping."
                        fi
                    '''
                }
            }
        }

        // ==========================================
        // BACKEND DOCKER
        // ==========================================

        stage('Build Backend Docker Image') {
            when {
                expression { env.BUILD_BACKEND == 'true' }
            }

            steps {
                dir('app/server') {
                    sh '''
                        set -eu

                        echo "===== BUILDING BACKEND IMAGE ====="

                        docker build --pull \
                            -f Dockerfile.prod \
                            -t enterprise-backend:${IMAGE_TAG} \
                            .

                        echo "Backend image built successfully!"
                    '''
                }
            }
        }

        stage('Validate Backend Docker Image') {
            when {
                expression { env.BUILD_BACKEND == 'true' }
            }

            steps {
                withEnv([
                    "TEST_CONTAINER=jenkins-backend-test-${env.BUILD_NUMBER}",
                    "TEST_IMAGE=enterprise-backend:${env.IMAGE_TAG}"
                ]) {
                    sh '''
                        set -eu

                        cleanup() {
                            docker rm -f "$TEST_CONTAINER" \
                                >/dev/null 2>&1 || true
                        }

                        trap cleanup EXIT

                        echo "===== STARTING BACKEND CONTAINER ====="

                        docker run -d \
                            --name "$TEST_CONTAINER" \
                            --restart=no \
                            --memory=512m \
                            -e PORT=9000 \
                            -p 127.0.0.1::9000 \
                            "$TEST_IMAGE" >/dev/null

                        echo "===== WAITING FOR BACKEND HEALTH ====="

                        status=starting

                        for attempt in $(seq 1 40); do
                            status=$(docker inspect \
                                --format='{{.State.Health.Status}}' \
                                "$TEST_CONTAINER")

                            if [ "$status" = "healthy" ]; then
                                break
                            fi

                            container_state=$(docker inspect \
                                --format='{{.State.Status}}' \
                                "$TEST_CONTAINER")

                            if [ "$container_state" = "exited" ] || \
                               [ "$container_state" = "dead" ]; then
                                docker logs "$TEST_CONTAINER"
                                exit 1
                            fi

                            sleep 3
                        done

                        if [ "$status" != "healthy" ]; then
                            docker logs "$TEST_CONTAINER"
                            docker inspect "$TEST_CONTAINER"
                            exit 1
                        fi

                        echo "===== CHECKING BACKEND HTTP ENDPOINT ====="

                        HOST_PORT=$(docker port "$TEST_CONTAINER" 9000/tcp \
                            | awk -F: 'NR == 1 {print $NF}')

                        HTTP_STATUS=$(curl -sS \
                            -o /tmp/backend-health-${BUILD_NUMBER}.json \
                            -w '%{http_code}' \
                            "http://127.0.0.1:${HOST_PORT}/health")

                        cat "/tmp/backend-health-${BUILD_NUMBER}.json"

                        if [ "$HTTP_STATUS" != "200" ]; then
                            echo "Backend HTTP health validation failed"
                            exit 1
                        fi

                        echo "Backend image passed validation!"
                    '''
                }
            }
        }

        // ==========================================
        // FRONTEND DOCKER
        // ==========================================

        stage('Build Frontend Docker Image') {
            when {
                expression { env.BUILD_FRONTEND == 'true' }
            }

            steps {
                dir('app/client') {
                    sh '''
                        set -eu

                        echo "===== BUILDING FRONTEND IMAGE ====="

                        docker build --pull \
                            -f Dockerfile.prod \
                            -t enterprise-frontend:${IMAGE_TAG} \
                            .

                        echo "Frontend image built successfully!"
                    '''
                }
            }
        }

        stage('Validate Frontend Docker Image') {
            when {
                expression { env.BUILD_FRONTEND == 'true' }
            }

            steps {
                withEnv([
                    "TEST_CONTAINER=jenkins-frontend-test-${env.BUILD_NUMBER}",
                    "TEST_IMAGE=enterprise-frontend:${env.IMAGE_TAG}"
                ]) {
                    sh '''
                        set -eu

                        cleanup() {
                            docker rm -f "$TEST_CONTAINER" \
                                >/dev/null 2>&1 || true
                        }

                        trap cleanup EXIT

                        echo "===== STARTING FRONTEND CONTAINER ====="

                        docker run -d \
                            --name "$TEST_CONTAINER" \
                            --restart=no \
                            --memory=256m \
                            -p 127.0.0.1::80 \
                            "$TEST_IMAGE" >/dev/null

                        echo "===== WAITING FOR NGINX ====="

                        HOST_PORT=$(docker port "$TEST_CONTAINER" 80/tcp \
                            | awk -F: 'NR == 1 {print $NF}')

                        HTTP_STATUS=000

                        for attempt in $(seq 1 30); do
                            HTTP_STATUS=$(curl -sS \
                                -o /tmp/frontend-health-${BUILD_NUMBER}.html \
                                -w '%{http_code}' \
                                "http://127.0.0.1:${HOST_PORT}/" \
                                || true)

                            if [ "$HTTP_STATUS" = "200" ]; then
                                break
                            fi

                            sleep 2
                        done

                        if [ "$HTTP_STATUS" != "200" ]; then
                            echo "Frontend HTTP validation failed"
                            docker logs "$TEST_CONTAINER"
                            exit 1
                        fi

                        echo "Frontend HTTP response:"
                        head -c 500 "/tmp/frontend-health-${BUILD_NUMBER}.html"

                        echo ""
                        echo "Frontend image passed validation!"
                    '''
                }
            }
        }

        // ==========================================
        // ECR AUTHENTICATION
        // ==========================================

        stage('Authenticate with Amazon ECR') {
            when {
                expression {
                    env.BUILD_BACKEND == 'true' ||
                    env.BUILD_FRONTEND == 'true'
                }
            }

            steps {
                sh '''
                    set -eu

                    echo "===== AUTHENTICATING WITH ECR ====="

                    aws ecr get-login-password \
                        --region "$AWS_REGION" | \
                    docker login \
                        --username AWS \
                        --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        // ==========================================
        // PUSH BACKEND IMAGE
        // ==========================================

        stage('Push Backend Image to ECR') {
            when {
                expression { env.BUILD_BACKEND == 'true' }
            }

            steps {
                sh '''
                    set -eu

                    ECR_IMAGE="${ECR_REGISTRY}/${BACKEND_ECR_REPOSITORY}:${IMAGE_TAG}"

                    echo "===== TAGGING BACKEND IMAGE ====="

                    docker tag \
                        "enterprise-backend:${IMAGE_TAG}" \
                        "$ECR_IMAGE"

                    echo "===== PUSHING BACKEND IMAGE ====="

                    docker push "$ECR_IMAGE"

                    echo "===== VERIFYING BACKEND IMAGE ====="

                    aws ecr describe-images \
                        --repository-name "$BACKEND_ECR_REPOSITORY" \
                        --region "$AWS_REGION" \
                        --image-ids imageTag="$IMAGE_TAG" \
                        --output json
                '''
            }
        }

        // ==========================================
        // PUSH FRONTEND IMAGE
        // ==========================================

        stage('Push Frontend Image to ECR') {
            when {
                expression { env.BUILD_FRONTEND == 'true' }
            }

            steps {
                sh '''
                    set -eu

                    ECR_IMAGE="${ECR_REGISTRY}/${FRONTEND_ECR_REPOSITORY}:${IMAGE_TAG}"

                    echo "===== TAGGING FRONTEND IMAGE ====="

                    docker tag \
                        "enterprise-frontend:${IMAGE_TAG}" \
                        "$ECR_IMAGE"

                    echo "===== PUSHING FRONTEND IMAGE ====="

                    docker push "$ECR_IMAGE"

                    echo "===== VERIFYING FRONTEND IMAGE ====="

                    aws ecr describe-images \
                        --repository-name "$FRONTEND_ECR_REPOSITORY" \
                        --region "$AWS_REGION" \
                        --image-ids imageTag="$IMAGE_TAG" \
                        --output json
                '''
            }
        }
    }

    // ==========================================
    // POST BUILD ACTIONS
    // ==========================================

    post {
        success {
            echo 'Selective CI and ECR publishing completed successfully.'

            echo "Commit: ${env.IMAGE_TAG}"
            echo "Backend built: ${env.BUILD_BACKEND}"
            echo "Frontend built: ${env.BUILD_FRONTEND}"

            script {
                if (env.BUILD_BACKEND == 'true') {
                    echo "Backend image: ${env.ECR_REGISTRY}/${env.BACKEND_ECR_REPOSITORY}:${env.IMAGE_TAG}"
                }

                if (env.BUILD_FRONTEND == 'true') {
                    echo "Frontend image: ${env.ECR_REGISTRY}/${env.FRONTEND_ECR_REPOSITORY}:${env.IMAGE_TAG}"
                }

                if (env.BUILD_BACKEND == 'false' &&
                    env.BUILD_FRONTEND == 'false') {
                    echo 'Documentation-only change. No images were built or pushed.'
                }
            }
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
