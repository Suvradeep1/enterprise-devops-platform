###################################################
# Stage 1 - Build React Application
###################################################

FROM node:20-alpine AS builder

WORKDIR /usr/src/app

COPY package*.json ./

RUN npm ci --legacy-peer-deps

COPY . .

RUN npm run build

###################################################
# Stage 2 - Production Nginx
###################################################

FROM nginx:alpine

LABEL org.opencontainers.image.title="Enterprise DevOps Platform Frontend"
LABEL org.opencontainers.image.description="Production frontend for the Enterprise DevOps Platform"
LABEL org.opencontainers.image.vendor="Suvradeep Chowdhury"
LABEL org.opencontainers.image.source="https://github.com/Suvradeep1/enterprise-devops-platform"

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /usr/src/app/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx","-g","daemon off;"]
